# Copy to .env (git-ignored) and adjust. Real environment variables win over this file.

# The Postgres server started by docker-compose.yml
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme
PGPORT=5441
PGSCHEMA_IMAGE=pgplex/pgschema:latest

# The tripwire database and its own role. `task db:up` creates both from this URL.
# Setting it also switches the postgres change-history reporter on.
DATABASE_URL=postgresql://tripwire:changeme@localhost:5441/tripwire

# Telegram alerts. Both set = telegram reporter on. Leave empty to stay on stdout only.
TG_TOKEN=
TG_CHAT=

# GitHub token that can read public repositories. The live activity feed needs it.
# A fine-grained token with "Public repositories (read-only)" and no other permission is enough.
GH_READ_TOKEN=
